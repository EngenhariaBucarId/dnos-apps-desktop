{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Janela principal: a página local (carregando / sem conexão) e a instância web do dn.os. A instância remota precisa das mesmas permissões para notificação nativa, deep link e abrir link externo.",
  "windows": ["main"],
  "remote": {
    "urls": [
      "https://dnos.dnia.ai/*",
      "https://*.lovable.app/*",
      "https://*.lovableproject.com/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "core:window:allow-set-title",
    "notification:default",
    "deep-link:default",
    "opener:allow-open-url",
    "os:allow-platform",
    "os:allow-version",
    "process:allow-restart",
    "updater:default"
  ]
}
